# ============================================================
#  서초구 상인회 플랫폼 — 환경 변수 예시
#  이 파일을 복사해 `.env` 로 만들고 값을 채우세요.  (cp .env.example .env)
#  `.env` 는 절대 저장소에 커밋하지 마세요 (.gitignore 에 이미 포함).
# ============================================================

# ---- 기본 ----
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ---- 세션 (필수) ----
# 아무나 못 맞추는 긴 랜덤 문자열. 아래 명령으로 생성:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- 데이터베이스 파일 경로 ----
DB_FILE=/app/data/app.db

# ---- 초기 계정 (첫 시드 시에만 사용) ----
SUPERADMIN_EMAIL=super@platform.kr
SUPERADMIN_PASSWORD=change-this-super-password
ADMIN_EMAIL=admin@seocho-merchants.kr
ADMIN_PASSWORD=change-this-admin-password

# ---- 주소 방식 ----
# 서브도메인 분양(예: seocho.example.com)을 쓰면 BASE_DOMAIN 설정. 미설정 시 경로(/t/:slug) 방식.
# BASE_DOMAIN=example.com
PUBLIC_SCHEME=https

# ---- 네이버 지도 (선택) ----
# 네이버 클라우드 플랫폼 Maps 에서 발급한 클라이언트 ID. 콘솔에 서비스 도메인 등록 필요.
# 없으면 지도 목록 폴백으로 자동 동작.
# NAVER_MAP_CLIENT_ID=your-naver-client-id
# NAVER_MAP_PARAM=ncpClientId   # 신규 콘솔은 ncpKeyId

# ---- 스토리지 (선택) ----
# local(기본) | s3.  사진이 많아지면 Cloudflare R2(전송비 0) 권장.
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_REGION=auto
# S3_BUCKET=your-bucket
# S3_ACCESS_KEY_ID=xxx
# S3_SECRET_ACCESS_KEY=xxx
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # R2/MinIO 등
# S3_PUBLIC_BASE_URL=https://cdn.example.com                  # 퍼블릭/CDN 베이스
# S3_FORCE_PATH_STYLE=false

# ---- 전자서명 개인키 (선택, 권장) ----
# 미설정 시 data/sign_key.json 에 자동 생성·영속. 운영에선 PEM 을 여기에 넣는 것을 권장.
# SIGN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ---- 업로드/미디어 튜닝 (선택) ----
# MAX_CONCURRENT_UPLOADS=3
# MAX_EMBEDS_PER_BUSINESS=30
# MEDIA_TRANSCODE=true
# MEDIA_POSTER=true

# ---- 로깅 ----
LOG_REQUESTS=1
