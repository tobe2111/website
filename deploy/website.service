# systemd 서비스 유닛 — Docker 없이 서버에서 직접 구동할 때 사용
# 설치:
#   sudo cp deploy/website.service /etc/systemd/system/seocho-website.service
#   (경로·User·EnvironmentFile 을 실제 환경에 맞게 수정)
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now seocho-website
# 로그:  journalctl -u seocho-website -f

[Unit]
Description=Seocho Merchants Website
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/seocho-website
EnvironmentFile=/opt/seocho-website/.env
ExecStart=/usr/bin/node --experimental-sqlite src/server.js
Restart=always
RestartSec=3
# 재부팅 후에도 자동 시작. 데이터는 WorkingDirectory/data 에 영속됩니다.

# 보안 강화(선택)
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
