# Caddy 리버스 프록시 — HTTPS 인증서 자동 발급·갱신(Let's Encrypt)
# docker-compose 의 caddy 서비스가 DOMAIN 환경변수를 주입합니다.
# 도메인이 실제로 이 서버 IP 를 가리키고(80/443 오픈) 있어야 인증서가 발급됩니다.

{$DOMAIN} {
	encode gzip
	reverse_proxy app:3000

	# 정적 자산은 앱이 자체 캐시 헤더를 주지만, 여기서도 로그 최소화
	log {
		output stdout
		format console
	}
}

# 로컬 테스트용(도메인 없이): `DOMAIN=localhost docker compose --profile edge up`
# 이 경우 Caddy 는 내부 자체서명 인증서를 사용합니다.
